<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- WPF built-in boolean-to-visibility converter, registered globally. -->
    <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>

    <!-- YFGDESK brand palette: dark navy + teal accent -->
    <Color x:Key="BrandNavy">#0A1220</Color>
    <Color x:Key="BrandNavyLight">#141E33</Color>
    <Color x:Key="BrandTeal">#2CE2CA</Color>
    <Color x:Key="BrandTealDark">#1FAE9C</Color>
    <Color x:Key="BrandError">#FF5C5C</Color>
    <Color x:Key="BrandWarn">#FFB454</Color>
    <Color x:Key="BrandOk">#7DE08B</Color>
    <Color x:Key="Foreground">#E6EAF0</Color>
    <Color x:Key="ForegroundDim">#9BA5B5</Color>
    <Color x:Key="BackgroundPanel">#0F1828</Color>

    <SolidColorBrush x:Key="BrandNavyBrush"  Color="{StaticResource BrandNavy}"/>
    <SolidColorBrush x:Key="BrandNavyLightBrush" Color="{StaticResource BrandNavyLight}"/>
    <SolidColorBrush x:Key="BrandTealBrush"  Color="{StaticResource BrandTeal}"/>
    <SolidColorBrush x:Key="BrandTealDarkBrush" Color="{StaticResource BrandTealDark}"/>
    <SolidColorBrush x:Key="BrandErrorBrush" Color="{StaticResource BrandError}"/>
    <SolidColorBrush x:Key="BrandWarnBrush"  Color="{StaticResource BrandWarn}"/>
    <SolidColorBrush x:Key="BrandOkBrush"   Color="{StaticResource BrandOk}"/>
    <SolidColorBrush x:Key="ForegroundBrush" Color="{StaticResource Foreground}"/>
    <SolidColorBrush x:Key="ForegroundDimBrush" Color="{StaticResource ForegroundDim}"/>
    <SolidColorBrush x:Key="BackgroundPanelBrush" Color="{StaticResource BackgroundPanel}"/>

    <!-- Default button style: teal accent on dark -->
    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource BrandTealBrush}"/>
        <Setter Property="Foreground" Value="#0A1220"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="16,8"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource BrandTealDarkBrush}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{StaticResource ForegroundDimBrush}"/>
                <Setter Property="Foreground" Value="#0A1220"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="Background" Value="{StaticResource BrandErrorBrush}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#CC4444"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="Background" Value="{StaticResource BrandNavyLightBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#1C2A48"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- TextBox -->
    <Style TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource BackgroundPanelBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource ForegroundDimBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontFamily" Value="Consolas, 'Segoe UI', Tahoma"/>
    </Style>

    <!-- TextBlock -->
    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}"/>
        <Setter Property="FontFamily" Value="'Segoe UI', Tahoma"/>
    </Style>

</ResourceDictionary>
