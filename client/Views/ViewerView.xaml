<UserControl x:Class="YfgDesk.Client.Views.ViewerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BrandNavyBrush}"
             FlowDirection="RightToLeft">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Target ID input -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="شناسهٔ دستگاه مقصد" FontSize="12" Foreground="{StaticResource ForegroundDimBrush}"/>
            <TextBox x:Name="TargetIdBox" Text="{Binding TargetIdInput, UpdateSourceTrigger=PropertyChanged}"
                     FontSize="22" FontFamily="Consolas" Padding="8,8" MaxLength="11"/>
            <TextBlock Text="{Binding TargetIdError}" Foreground="{StaticResource BrandErrorBrush}" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Permissions -->
        <StackPanel Grid.Row="1" Margin="0,0,0,16">
            <TextBlock Text="دسترسی‌های درخواستی" FontSize="12" Foreground="{StaticResource ForegroundDimBrush}" Margin="0,0,0,4"/>
            <StackPanel Orientation="Horizontal">
                <CheckBox Content="مشاهده صفحه" IsChecked="{Binding RequestViewScreen}" Margin="0,0,16,0" VerticalAlignment="Center"/>
                <CheckBox Content="کنترل از راه دور" IsChecked="{Binding RequestRemoteControl}" Margin="0,0,16,0" VerticalAlignment="Center"/>
                <CheckBox Content="انتقال فایل" IsChecked="{Binding RequestFileTransfer}" VerticalAlignment="Center"/>
            </StackPanel>
        </StackPanel>

        <!-- Quality selector -->
        <StackPanel Grid.Row="2" Margin="0,0,0,16">
            <TextBlock Text="کیفیت تصویر" FontSize="12" Foreground="{StaticResource ForegroundDimBrush}" Margin="0,0,0,4"/>
            <ComboBox x:Name="QualityCombo" SelectedIndex="{Binding QualityMode}" Width="200" HorizontalAlignment="Left">
                <ComboBoxItem Content="پایین"/>
                <ComboBoxItem Content="استاندارد"/>
                <ComboBoxItem Content="سفارشی"/>
            </ComboBox>
        </StackPanel>

        <!-- Request button -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,16">
            <Button Style="{StaticResource PrimaryButton}" Content="درخواست اتصال"
                    IsEnabled="{Binding RequestEnabled}" Click="OnRequest"
                    Padding="32,10"/>
            <TextBlock Text="{Binding StatusText}" Margin="16,0,0,0" VerticalAlignment="Center"
                       Foreground="{StaticResource ForegroundDimBrush}"/>
        </StackPanel>

        <!-- Remote video placeholder (the WebView2 will be embedded here at runtime) -->
        <Border Grid.Row="5" Background="#000000" CornerRadius="6" MinHeight="280">
            <Grid x:Name="VideoHostPanel"/>
        </Border>

        <!-- Bottom state -->
        <Border Grid.Row="6" Background="{StaticResource BrandNavyLightBrush}" Padding="10,6">
            <StackPanel Orientation="Horizontal">
                <Ellipse Width="10" Height="10" Margin="0,0,6,0" VerticalAlignment="Center">
                    <Ellipse.Fill>
                        <SolidColorBrush Color="{StaticResource BrandWarn}"/>
                    </Ellipse.Fill>
                </Ellipse>
                <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
