{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "YfgDesk": {
    "DatabaseConnectionString": "Data Source=yfgdesk.db",
    "MaxRequestBodyBytes": 32768,
    "PerEndpointMaxBodyBytes": 16384,
    "ChallengeTtlSeconds": 60,
    "MaxPendingChallenges": 4096,
    "BearerTtlSeconds": 604800,
    "EnrollIpRateLimitPerMinute": 60,
    "WsDeviceRateLimitPerMinute": 60,
    "ConsentWaitSeconds": 300,
    "SessionIdleSeconds": 120,
    "SessionMaxLifetimeSeconds": 43200,
    "SweepIntervalSeconds": 30,
    "WsKeepAliveSeconds": 15,
    "HeartbeatIntervalSeconds": 30,
    "ReplayWindowSize": 512,
    "TimestampSkewSeconds": 120,
    "Turn": {
      "Urls": [],
      "SharedSecret": "",
      "Realm": "",
      "TtlSeconds": 7200
    }
  }
}
