# Dockerfile for the YFGDESK v2 server (self-contained ASP.NET Core 10 app).

# ---- Build stage ----
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

# Copy shared + server csproj files first (cache-friendly layer)
COPY shared/YfgDesk.Shared.csproj ./shared/
COPY server/YfgDesk.Server.csproj ./server/
RUN dotnet restore server/YfgDesk.Server.csproj

# Copy source and publish
COPY shared/ ./shared/
COPY server/ ./server/
RUN dotnet publish server/YfgDesk.Server.csproj \
    -c Release \
    -o /out \
    --no-restore \
    /p:UseAppHost=false

# ---- Runtime stage ----
FROM mcr.microsoft.com/dotnet/aspnet:10.0
WORKDIR /app

# Non-root user
RUN adduser --disabled-password --gecos "" --uid 1654 yfgdesk && \
    mkdir -p /data && chown yfgdesk:yfgdesk /data
USER yfgdesk

COPY --from=build /out ./

ENV ASPNETCORE_URLS=http://+:8080 \
    ASPNETCORE_ENVIRONMENT=Production \
    YFGDESK_DB=Data\ Source=/data/yfgdesk.db

EXPOSE 8080

# Healthcheck
HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
    CMD curl -fsS http://localhost:8080/api/health || exit 1

ENTRYPOINT ["dotnet", "YfgDesk.Server.dll"]
