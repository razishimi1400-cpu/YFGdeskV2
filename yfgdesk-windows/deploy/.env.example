# Copy to .env (outside version control) and set real values.

# Public DNS name clients connect to (e.g. remote.yourdomain.com)
YFGDESK_DOMAIN=remote.example.com

# TURN server public DNS (must match YFGDESK_DOMAIN or be a separate host)
TURN_REALM=remote.example.com

# Comma-separated TURN URLs advertised to clients (must be reachable from
# the client's network — usually the same public host).
TURN_URLS=turn:remote.example.com:3478?transport=udp,turn:remote.example.com:3478?transport=tcp

# Random 64 hex characters — used as the coturn REST API auth secret.
# Generate with: openssl rand -hex 32
TURN_SHARED_SECRET=REPLACE_WITH_64_RANDOM_HEX_CHARACTERS
