<?xml version="1.0" encoding="UTF-8"?>
<!--
  YFG YASTA v2 — WiX v5 MSI package definition for the SERVER.

  Produces YFGdesk-Server-Setup.msi — installs the signaling/TURN server
  as a Windows Service that starts automatically on boot.

  Prerequisite: publish the server first via build-installer.bat
  (the installer harvests files from .\publish\server-single\).
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
    Name="YFG YASTA Server"
    Language="1065"
    Codepage="1256"
    Manufacturer="YFGSYSTEMS"
    Version="2.0.0.0"
    UpgradeCode="B7C9D1E2-3F4A-5B6C-7D8E-9F0A1B2C3D4E">

    <SummaryInformation
      Description="YFG YASTA Signaling + TURN Server v2.0"
      Manufacturer="YFGSYSTEMS"
      Codepage="1256"
      Keywords="YFG;YASTA;Server;Signaling;TURN;Installer" />

    <MajorUpgrade
      DowngradeErrorMessage="A newer version of YFG YASTA Server is already installed."
      Schedule="afterInstallValidate"
      AllowSameVersion="yes" />

    <Media Id="1" Cabinet="YFGdeskServer.cab" EmbedCab="yes" />

    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />
    <UIRef Id="WixUI_InstallDir" />
    <Property Id="ARPPRODUCTICON" Value="YfgServerIcon" />
    <Property Id="ARPCONTACT" Value="YFGSYSTEMS" />
    <Property Id="ARPHELPLINK" Value="https://github.com/razishimi1400-cpu/YFGdeskV2" />
    <Property Id="ARPNOREPAIR" Value="yes" />
    <Property Id="ARPNOMODIFY" Value="yes" />

    <Feature Id="CompleteFeature" Title="YFG YASTA Server" Level="1"
             Description="YFG YASTA signaling + TURN credential server.">
      <ComponentGroupRef Id="HarvestedServerFiles" />
      <ComponentRef Id="ServerShortcutStartMenu" />
      <ComponentRef Id="ServerServiceInstall" />
      <ComponentRef Id="ServerRegistryInstallInfo" />
    </Feature>

    <Launch Condition="Privileged" Message="Administrator access is required to install the YFG YASTA Server." />
    <Launch Condition="VersionNT64" Message="YFG YASTA Server requires a 64-bit version of Windows." />
  </Package>

  <Fragment Id="Folders">
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="YFGYastaServer" />
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="YfgServerProgramMenuFolder" Name="YFGYastaServer" />
    </StandardDirectory>
  </Fragment>

  <Fragment Id="Shortcuts">
    <DirectoryRef Id="YfgServerProgramMenuFolder">
      <Component Id="ServerShortcutStartMenu" Guid="{C9D1E2F4-1111-2222-3333-444455557777}">
        <Shortcut Id="ServerStartMenuShortcut"
                  Name="YFG YASTA Server (console)"
                  Description="Run YFG YASTA Server in console mode"
                  Target="[INSTALLFOLDER]YfgDesk.Server.exe"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="YfgServerIcon" />
        <RemoveFolder Id="RemoveServerProgramMenuFolder" On="uninstall" />
        <RegistryValue Root="HKLM"
                       Key="SOFTWARE\YFGYastaServer"
                       Name="StartMenuShortcut"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>
    </DirectoryRef>
  </Fragment>

  <!-- Windows Service installation -->
  <Fragment Id="ServerService">
    <DirectoryRef Id="INSTALLFOLDER">
      <Component Id="ServerServiceInstall" Guid="{C9D1E2F4-3333-4444-5555-666677778888}">
        <ServiceInstall
          Id="YfgServerService"
          Name="YfgYastaServer"
          DisplayName="YFG YASTA Signaling Server"
          Description="YFG YASTA remote desktop discovery + signaling + TURN credential issuer."
          Type="ownProcess"
          Start="auto"
          ErrorControl="normal"
          Interactive="no"
          Arguments="--service" />

        <ServiceControl
          Id="YfgServerServiceControl"
          Name="YfgYastaServer"
          Start="install"
          Stop="both"
          Remove="uninstall"
          Wait="yes" />

        <!-- Environment variables for the service -->
        <Environment Id="YfgDb" Name="YFGDESK_DB"
                      Value="[INSTALLFOLDER]yfgdesk.db"
                      Permanent="no" Part="all" Action="set" System="yes" />
        <Environment Id="AspnetUrls" Name="ASPNETCORE_URLS"
                      Value="http://0.0.0.0:7070"
                      Permanent="no" Part="all" Action="set" System="yes" />
        <Environment Id="AspnetEnv" Name="ASPNETCORE_ENVIRONMENT"
                      Value="Production"
                      Permanent="no" Part="all" Action="set" System="yes" />

        <RegistryValue Root="HKLM"
                       Key="SOFTWARE\YFGYastaServer"
                       Name="ServiceInstalled"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>

      <Component Id="ServerRegistryInstallInfo" Guid="{C9D1E2F4-5555-6666-7777-888899990000}">
        <RegistryValue Root="HKLM"
                       Key="SOFTWARE\YFGYastaServer"
                       Name="InstallPath"
                       Type="string"
                       Value="[INSTALLFOLDER]"
                       KeyPath="yes" />
        <RegistryValue Root="HKLM"
                       Key="SOFTWARE\YFGYastaServer"
                       Name="Version"
                       Type="string"
                       Value="2.0.0.0" />
      </Component>
    </DirectoryRef>
  </Fragment>

  <Fragment Id="Icons">
    <Icon Id="YfgServerIcon" SourceFile="$(MSBuildProjectDirectory)\..\client\Assets\yfgdesk-mark.ico" />
  </Fragment>
</Wix>
