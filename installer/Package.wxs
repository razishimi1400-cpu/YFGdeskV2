<?xml version="1.0" encoding="UTF-8"?>
<!--
  YFG YASTA v2 — WiX v5 MSI package definition for the CLIENT.

  Produces YFGdesk-Setup.msi — a real Windows installer with:
    - Per-machine install into C:\Program Files\YFGYasta\
    - Start Menu + optional Desktop shortcuts
    - Add/Remove Programs entry with uninstaller
    - Auto-kill running instance before upgrade
    - Bilingual installer UI (Persian default)

  Prerequisite: publish the client first via build-installer.bat
  (the installer harvests files from .\publish\client-single\).
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
    Name="YFG YASTA"
    Language="1065"
    Codepage="1256"
    Manufacturer="YFGSYSTEMS"
    Version="2.0.0.0"
    UpgradeCode="8F4A3B2C-7E5D-4F1A-9C8B-3A6D5E4F7B2C">

    <SummaryInformation
      Description="YFG YASTA Remote Desktop Support v2.0"
      Manufacturer="YFGSYSTEMS"
      Codepage="1256"
      Keywords="YFG;YASTA;Remote;Desktop;Installer" />

    <!-- Upgrade: newer build replaces older ones -->
    <MajorUpgrade
      DowngradeErrorMessage="A newer version of YFG YASTA is already installed."
      Schedule="afterInstallValidate"
      AllowSameVersion="yes" />

    <Media Id="1" Cabinet="YFGdesk.cab" EmbedCab="yes" />

    <!-- Installer UI -->
    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />
    <UIRef Id="WixUI_InstallDir" />
    <Property Id="ARPPRODUCTICON" Value="YfgDeskIcon" />
    <Property Id="ARPCONTACT" Value="YFGSYSTEMS" />
    <Property Id="ARPHELPLINK" Value="https://github.com/razishimi1400-cpu/YFGdeskV2" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/razishimi1400-cpu/YFGdeskV2" />
    <Property Id="ARPNOREPAIR" Value="yes" />
    <Property Id="ARPNOMODIFY" Value="yes" />

    <!-- Top-level feature -->
    <Feature Id="CompleteFeature" Title="YFG YASTA" Level="1"
             Description="Complete installation of YFG YASTA remote desktop client.">
      <ComponentGroupRef Id="HarvestedClientFiles" />
      <ComponentRef Id="ShortcutStartMenu" />
      <ComponentRef Id="ShortcutDesktop" />
      <ComponentRef Id="RegistryInstallInfo" />
    </Feature>

    <!-- Install conditions -->
    <Launch Condition="Privileged" Message="Administrator access is required to install YFG YASTA." />
    <Launch Condition="VersionNT64" Message="YFG YASTA requires a 64-bit version of Windows." />
  </Package>

  <!-- Folder structure -->
  <Fragment Id="Folders">
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="YFGYasta" />
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="YfgProgramMenuFolder" Name="YFGYasta" />
    </StandardDirectory>

    <StandardDirectory Id="DesktopFolder" />
  </Fragment>

  <!-- Shortcuts -->
  <Fragment Id="Shortcuts">
    <!-- Start Menu shortcut -->
    <DirectoryRef Id="YfgProgramMenuFolder">
      <Component Id="ShortcutStartMenu" Guid="{A1B2C3D4-1111-2222-3333-444455556666}">
        <Shortcut Id="StartMenuShortcut"
                  Name="YFG YASTA"
                  Description="YFG YASTA Remote Desktop Support"
                  Target="[INSTALLFOLDER]YfgDesk.Client.exe"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="YfgDeskIcon" />
        <RemoveFolder Id="RemoveYfgProgramMenuFolder" On="uninstall" />
        <RegistryValue Root="HKLM"
                       Key="SOFTWARE\YFGYasta"
                       Name="StartMenuShortcut"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <!-- Desktop shortcut (optional, controlled by WixUI checkbox) -->
    <DirectoryRef Id="DesktopFolder">
      <Component Id="ShortcutDesktop" Guid="{A1B2C3D4-7777-8888-9999-AAAABBBBCCCC}">
        <Shortcut Id="DesktopShortcut"
                  Name="YFG YASTA"
                  Description="YFG YASTA Remote Desktop Support"
                  Target="[INSTALLFOLDER]YfgDesk.Client.exe"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="YfgDeskIcon" />
        <RemoveFolder Id="RemoveDesktopShortcut" On="uninstall" />
        <RegistryValue Root="HKLM"
                       Key="SOFTWARE\YFGYasta"
                       Name="DesktopShortcut"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <!-- Registry: install path + version -->
    <DirectoryRef Id="INSTALLFOLDER">
      <Component Id="RegistryInstallInfo" Guid="{A1B2C3D4-DDDD-EEEE-FFFF-001122334455}">
        <RegistryValue Root="HKLM"
                       Key="SOFTWARE\YFGYasta"
                       Name="InstallPath"
                       Type="string"
                       Value="[INSTALLFOLDER]"
                       KeyPath="yes" />
        <RegistryValue Root="HKLM"
                       Key="SOFTWARE\YFGYasta"
                       Name="Version"
                       Type="string"
                       Value="2.0.0.0" />
      </Component>
    </DirectoryRef>
  </Fragment>

  <!-- Icon (embedded into the MSI) -->
  <Fragment Id="Icons">
    <Icon Id="YfgDeskIcon" SourceFile="$(MSBuildProjectDirectory)\..\client\Assets\yfgdesk-mark.ico" />
  </Fragment>

  <!-- Custom action: kill any running instance before install/upgrade -->
  <Fragment Id="KillRunning">
    <CustomAction Id="KillRunningYfgDesk"
                  BinaryRef="WixCA"
                  DllEntry="CAQuietExec"
                  Execute="immediate"
                  Return="ignore" />
    <Property Id="QtExecCmdLine" Value="taskkill.exe /im YfgDesk.Client.exe /f /t" />
    <InstallExecuteSequence>
      <Custom Action="KillRunningYfgDesk" Before="InstallValidate" Condition="NOT Installed" />
    </InstallExecuteSequence>
  </Fragment>
</Wix>
